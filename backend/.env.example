# Copy to .env and edit locally. Never commit .env.

# Database
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/gulf_crawler

# For local smoke tests without Postgres, use:
# DATABASE_URL=sqlite:///./gulf_crawler.db

# Optional identity string for HTTP User-Agent / robots politeness
CRAWLER_USER_AGENT=JobScraper/1.0 (+your-email@example.com)
CRAWLER_CONTACT_EMAIL=

MIN_DELAY_SECONDS=4
MAX_DELAY_SECONDS=30
WARMUP_DELAY_SECONDS=4
DUPLICATE_STOP_STREAK=30
PAGE_DELAY_MIN_SECONDS=6
PAGE_DELAY_MAX_SECONDS=12
LOCATION_GAP_SECONDS=5
MAX_PAGES_PER_RUN=20
MAX_CONSECUTIVE_FAILURES=3
EMPTY_PAGE_STOP_STREAK=2
UNCAPPED_MAX_PAGES=500

COOKIE_DIR=./cookies
BROWSER_PROFILE_DIR=./browser_profiles
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
